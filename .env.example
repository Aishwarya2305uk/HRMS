# Copy this file to .env.local and fill in real values. .env.local is
# gitignored — never commit real secrets.

# Supabase Postgres connection string (Dashboard → Connect → Session pooler).
# The session pooler (port 5432) suits the single long-running server, both
# locally and in production.
DATABASE_URL=postgresql://<user>:<password>@<pooler-host>:5432/postgres

# Long random string used to sign JWTs. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# REQUIRED in production (NODE_ENV=production): the server refuses to start
# unless this is set to at least 32 characters. In dev it falls back to an
# insecure placeholder so local setups keep working.
JWT_SECRET=

# Optional — defaults to 7d.
JWT_EXPIRES_IN=7d

# The ONE account the app creates on its own, the first time it connects to
# an empty database. Sign in with these, then add every other employee and
# manager from the People screen — never edit these to "reset" the admin
# later, they only take effect while no matching account exists yet.
ADMIN_EMAIL=admin@yourcompany.com
ADMIN_PASSWORD=
ADMIN_NAME=Administrator

# Bearer token required by the daily attendance-finalizer cron endpoint
# (/api/cron/finalize). The endpoint FAILS CLOSED: while this is unset it
# refuses to run (attendance still finalizes lazily on read, so nothing
# breaks — but set this in production so the scheduled cron can work).
CRON_SECRET=

# Comma-separated browser origins allowed to call the API cross-origin, e.g.
#   CORS_ORIGINS=https://your-app.vercel.app
# Leave blank in local dev (all origins allowed, with a startup warning).
# Set it in production so arbitrary websites can't call the API directly.
CORS_ORIGINS=

# Optional — Cloudflare Turnstile (CAPTCHA) on the login page. Create a
# widget at https://dash.cloudflare.com -> Turnstile (add BOTH localhost and
# your deployed hostname, e.g. your-app.vercel.app, to the widget's allowed
# hostnames — a missing hostname is the classic "works locally, fails on the
# live site" cause). Leave BOTH blank to skip CAPTCHA entirely — that's the
# default, and login works exactly as before.
#   VITE_TURNSTILE_SITE_KEY — public, goes in the frontend build.
#   TURNSTILE_SECRET_KEY    — private, server-side only, never commit a real one.
VITE_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
